PORT=5000
MONGODB_URI=mongodb://localhost:27017/face_annotator
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:5173,https://your-netlify-site.netlify.app

# Optional controlled administrator bootstrap. Keep these only in the backend secret store.
# On first start, creates this admin account. If the email already exists as an unassigned
# account, it is promoted. Use a separate account from all Operations Employee accounts.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Portal Administrator

# Cloudinary credentials are backend secrets; never place them in Vite/Netlify.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
REFERENCE_PHOTO_MAX_BYTES=5242880
